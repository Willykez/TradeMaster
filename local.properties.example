# Copy this file to local.properties (which Android Studio already creates
# and gitignores for you -- it holds sdk.dir). Add this line to it:

TWELVE_DATA_API_KEY=your_key_here

# Get a free key at https://twelvedata.com/pricing (free tier: 8
# requests/minute, 800/day -- comfortably covers a 15s polling interval for
# the whole ticker in a single batched request).
#
# If this key is missing or blank, the app still works: DashboardViewModel
# falls back to the local random-walk simulator so the UI never breaks, it
# just won't be *real* prices until you add a key.
